DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
JWT_SECRET=change-this-secret-before-public-use
PORT=3000

# Server-side only. Never expose this key to the browser.
YOUTUBE_API_KEY=
YOUTUBE_LIVE_CACHE_TTL=600000
YOUTUBE_RESOLVER_BATCH_SIZE=8
YOUTUBE_RESOLVER_INTERVAL=300000
YOUTUBE_QUOTA_BUDGET=800
